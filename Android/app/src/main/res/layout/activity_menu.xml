<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/generals_black"
    android:weightSum="2">

    <!-- Left: Background image placeholder -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:background="@drawable/bg_splash">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="★\nGENERALS\nCHALLENGE"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#20FFFFFF"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:text="Galaxy A30 • 1280x720 • Mali-G71 Optimized"
            android:textSize="8sp"
            android:textColor="#60FFFFFF"
            android:fontFamily="monospace" />
    </FrameLayout>

    <!-- Right: Menu like PC -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/generals_dark">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAIN MENU"
            android:textSize="12sp"
            android:textColor="@color/generals_gold"
            android:letterSpacing="0.25"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSkirmish"
            style="@style/Generals.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_skirmish"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCampaign"
            style="@style/Generals.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_campaign"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnMultiplayer"
            style="@style/Generals.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_multiplayer"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOptions"
            style="@style/Generals.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_options"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExit"
            style="@style/Generals.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_exit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textSize="8sp"
            android:textColor="@color/generals_grey"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</LinearLayout>
