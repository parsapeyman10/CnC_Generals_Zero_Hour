<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/generals_black"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPTIONS"
        android:textSize="18sp"
        android:textColor="@color/generals_gold_light"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Graphics, Sound &amp; Controls - Preserving PC INI Structure"
        android:textSize="9sp"
        android:textColor="@color/generals_grey"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderGraphics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="1.0"
        android:valueFrom="0.0"
        android:valueTo="1.0"
        android:stepSize="0.5" />

    <TextView
        android:id="@+id/tvGraphics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Graphics: Medium (A30 Optimized)"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnBack"
        style="@style/Generals.Button.Gold"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="BACK"
        android:layout_marginTop="24dp"
        android:layout_gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Engine: GameLogic • GameClient • INI • AI  (PC Structure)"
        android:textSize="8sp"
        android:textColor="#60FFFFFF"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp" />
</LinearLayout>
