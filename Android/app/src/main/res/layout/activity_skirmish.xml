<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/generals_black"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_faction"
        android:textSize="16sp"
        android:textColor="@color/generals_gold_light"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Factions like PC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="3"
        android:gravity="center">

        <!-- USA -->
        <LinearLayout
            android:id="@+id/cardUSA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/generals_blue"
                android:text="★"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_usa"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_usa_desc"
                android:textSize="9sp"
                android:textColor="@color/generals_grey_light"
                android:fontFamily="monospace"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laser • Air Force"
                android:textSize="8sp"
                android:textColor="@color/generals_grey"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- China -->
        <LinearLayout
            android:id="@+id/cardChina"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/generals_red"
                android:text="☭"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_china"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_china_desc"
                android:textSize="9sp"
                android:textColor="@color/generals_grey_light"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tank • Nuke"
                android:textSize="8sp"
                android:textColor="@color/generals_grey"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- GLA -->
        <LinearLayout
            android:id="@+id/cardGLA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/generals_green"
                android:text="☪"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_gla"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faction_gla_desc"
                android:textSize="9sp"
                android:textColor="@color/generals_grey_light"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stealth • Toxin"
                android:textSize="8sp"
                android:textColor="@color/generals_grey"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map select -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAP: TWILIGHT FLAME  •  PLAYERS: 2  •  START CASH: $10,000"
        android:textSize="9sp"
        android:textColor="@color/generals_grey"
        android:fontFamily="monospace"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStartGame"
        style="@style/Generals.Button.Gold"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="START GAME"
        android:layout_gravity="center"
        android:letterSpacing="0.15" />

</LinearLayout>
