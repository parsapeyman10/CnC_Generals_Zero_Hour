<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/generals_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_faction"
            android:textSize="13sp"
            android:textColor="@color/generals_gold_light"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Factions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/cardUSA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@color/generals_blue"
                    android:text="★"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_usa"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_usa_desc"
                    android:textSize="7sp"
                    android:textColor="@color/generals_grey_light"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardChina"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@color/generals_red"
                    android:text="☭"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_china"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_china_desc"
                    android:textSize="7sp"
                    android:textColor="@color/generals_grey_light"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGLA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@color/generals_green"
                    android:text="☪"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_gla"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faction_gla_desc"
                    android:textSize="7sp"
                    android:textColor="@color/generals_grey_light"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Map card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:padding="8dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@color/terrain_grass"
                    android:text="🐺\n8P"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:lineSpacingExtra="-2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_gorge_mish"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/generals_gold_light"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_gorge_mish_desc"
                        android:textSize="8sp"
                        android:textColor="@color/generals_grey_light"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 Players • Network Mode • FFA"
                        android:textSize="7sp"
                        android:textColor="@color/generals_grey"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="18sp"
                    android:textColor="@color/generals_green"
                    android:padding="8dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Network Mode Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NETWORK MODE - تعداد دشمنان"
            android:textSize="10sp"
            android:textColor="@color/generals_gold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginTop="10dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvEnemyCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تعداد دشمنان: 3"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="monospace"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />

        <!-- Enemy count selector 1-7 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="−"
                android:textSize="16sp"
                style="@style/Generals.Button" />

            <LinearLayout
                android:id="@+id/enemyCountContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">

                <!-- 1-7 dots will be generated dynamically, but static for layout -->
                <TextView android:id="@+id/dot1" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_button_gold" android:text="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/black" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot2" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="2" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot3" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="3" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot4" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="4" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot5" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="5" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot6" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="6" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
                <TextView android:id="@+id/dot7" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_panel" android:text="7" android:gravity="center" android:textSize="11sp" android:textColor="@color/white" android:layout_margin="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="16sp"
                style="@style/Generals.Button" />
        </LinearLayout>

        <!-- Difficulty -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="درجه سختی AI"
            android:textSize="10sp"
            android:textColor="@color/generals_grey_light"
            android:fontFamily="monospace"
            android:layout_gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnEasy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:text="@string/difficulty_easy" android:textSize="9sp" style="@style/Generals.Button" android:layout_margin="2dp" />
            <Button android:id="@+id/btnMedium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:text="@string/difficulty_medium" android:textSize="9sp" style="@style/Generals.Button.Gold" android:layout_margin="2dp" />
            <Button android:id="@+id/btnHard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:text="@string/difficulty_hard" android:textSize="9sp" style="@style/Generals.Button" android:layout_margin="2dp" />
            <Button android:id="@+id/btnBrutal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:text="@string/difficulty_brutal" android:textSize="9sp" style="@style/Generals.Button" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 8 Slots Preview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slots"
            android:textSize="10sp"
            android:textColor="@color/generals_grey_light"
            android:fontFamily="monospace"
            android:layout_gravity="center"
            android:layout_marginTop="10dp" />

        <GridLayout
            android:id="@+id/slotsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="true"
            android:layout_marginTop="4dp">

            <!-- Slot 1 Human -->
            <LinearLayout
                android:id="@+id/slot1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_button_gold"
                android:padding="4dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="8sp" android:textColor="@color/black" android:fontFamily="monospace" />
                <TextView android:id="@+id/slot1Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOU (USA)" android:textSize="8sp" android:textStyle="bold" android:textColor="@color/black" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Human" android:textSize="7sp" android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_panel" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="8sp" android:textColor="@color/generals_grey_light" />
                <TextView android:id="@+id/slot2Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI (China)" android:textSize="8sp" android:textStyle="bold" android:textColor="@color/white" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textSize="7sp" android:textColor="@color/generals_gold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_panel" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="8sp" android:textColor="@color/generals_grey_light" />
                <TextView android:id="@+id/slot3Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI (GLA)" android:textSize="8sp" android:textStyle="bold" android:textColor="@color/white" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textSize="7sp" android:textColor="@color/generals_gold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_panel" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="8sp" android:textColor="@color/generals_grey_light" />
                <TextView android:id="@+id/slot4Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI (USA)" android:textSize="8sp" android:textStyle="bold" android:textColor="@color/white" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textSize="7sp" android:textColor="@color/generals_gold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot5" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="#30FFFFFF" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="8sp" android:textColor="@color/generals_grey" />
                <TextView android:id="@+id/slot5Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closed" android:textSize="8sp" android:textColor="@color/generals_grey" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="7sp" android:textColor="@color/generals_grey" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot6" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="#30FFFFFF" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textSize="8sp" android:textColor="@color/generals_grey" />
                <TextView android:id="@+id/slot6Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closed" android:textSize="8sp" android:textColor="@color/generals_grey" android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot7" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="#30FFFFFF" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textSize="8sp" android:textColor="@color/generals_grey" />
                <TextView android:id="@+id/slot7Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closed" android:textSize="8sp" android:textColor="@color/generals_grey" android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout android:id="@+id/slot8" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:orientation="vertical" android:gravity="center" android:background="#30FFFFFF" android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textSize="8sp" android:textColor="@color/generals_grey" />
                <TextView android:id="@+id/slot8Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closed" android:textSize="8sp" android:textColor="@color/generals_grey" android:fontFamily="monospace" />
            </LinearLayout>
        </GridLayout>

        <Button
            android:id="@+id/btnStartGame"
            style="@style/Generals.Button.Gold"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:text="START گرگ‌میش (3 دشمن)"
            android:layout_gravity="center"
            android:letterSpacing="0.12"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
