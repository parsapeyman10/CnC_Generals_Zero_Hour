<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/generals_gold_dark" />
            <stroke android:width="1dp" android:color="@color/generals_gold_light" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/generals_gold" />
            <stroke android:width="1dp" android:color="@color/generals_gold_dark" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
